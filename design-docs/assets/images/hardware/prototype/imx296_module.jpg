<script type="text/javascript">
//<![CDATA[
jQuery(function($) {
    var form_mini_timer;
    var search_input_width = 160;
    var input_val = "";

    // add by 20240508
    $('#waveshare-search1 input').unbind('focus').focus(function(){
      searchKeyUp();
    })
    $('#waveshare-search1 input').unbind('keyup').keyup(function(){
      searchKeyUp();
    })
    function searchKeyUp() {
      input_val1 = $.trim($('#waveshare-search1 input').val());
      console.log(input_val);
      if(input_val1=='') {
        $('#waveshare-search1 .waveshare-search-list').html('<li><a href="/catalogsearch/advanced/"><div><i class="icon-advanced"></i>Advanced Search</div></a></li>')
      } else {
        if(input_val1 != input_val) {
          input_val = input_val1;
          $.get("/catalogsearch/ajax/suggest/?v=2&q="+input_val, function(data,status){
            if(status='success') {
              $('#waveshare-search1 .waveshare-search-list').html(data)
            }
          });
        }
        // <li><a href="#"><div><i class="icon-search"></i><span>匹配结果</span></div><div>86815</div></a></li>
      }
    }

})
//]]>
</script>
