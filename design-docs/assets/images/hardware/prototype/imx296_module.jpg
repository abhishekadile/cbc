  // 购物车数量有变化会更新这个block，即会重新加载
  var cartQty = 0 * 1;
  jQuery(document).ready(function($) {
    if (cartQty >= 1) {
      $('.header-container .waveshare_cart_num').text(cartQty);
      $('#waveshare-mini-cart2 .count').text(cartQty);
    } else {
      $('.header-container .waveshare_cart_num').text('');
      $('#waveshare-mini-cart2 .count').text('');
    }
  })
