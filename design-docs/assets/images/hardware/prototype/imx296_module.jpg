jQuery(function($){
    var $ = jQuery;
    var timer;
    function addopen() {
        clearTimeout(timer); 
        $('#ws-sidebar-home-top').addClass('open');
    }
    function delayedRemoveopen() {
        timer = setTimeout(function() {
            $('#ws-sidebar-home-top').removeClass('open');
        }, 100); 
    }
    $('#ws-show-products').on('click mouseenter', addopen);
    $('#ws-sidebar-home-top').on('mouseenter', addopen);
    $('#ws-show-products').on('mouseleave', delayedRemoveopen);
    $('#ws-sidebar-home-top').on('mouseleave', delayedRemoveopen);

    if (!('ontouchstart' in window)) {
        $('#ws-sidebar-home-top ul.level0 li').hover(
            function() {
                $(this).addClass('pick');
                if ($(this).children('ul').length > 0) {
                    $(this).children('ul').stop(true, true).show();
                }
            }, 
            function() {
                $(this).removeClass('pick');
                if ($(this).children('ul').length > 0) {
                    $(this).children('ul').stop(true, true).hide();
                }
            }
        );
    }

    $('#ws-sidebar-home-top li a').click(function(e) {
        e.stopPropagation();
    });
    $('#ws-sidebar-home-top ul.level0 li.parent > ul').hide();
    $('#ws-sidebar-home-top li > a > span').click(function(e) {
        if ('ontouchstart' in window) {
            e.stopPropagation();
            let $parentLi = $(this).parent().parent();
            if ($parentLi.children('ul').length > 0) {
                $parentLi.siblings().find('ul').hide();
                $parentLi.children('ul').toggle();
                return false;
            }
        }
    });
    delayedRemoveopen();
});
</script>                        </div>
